{
  "name": "signbridge",
  "version": "0.2.0",
  "description": "Turn hand signs into text and speech, and use a few safe voice commands, in your web browser.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node tests/core.test.mjs && node tests/ui.smoke.mjs && node tests/site.test.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
